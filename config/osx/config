#!/usr/bin/env bash

set -euo pipefail

dry_run=0
opinionated=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      ;;
    --opinionated)
      opinionated=1
      ;;
    *)
      printf 'Unknown macOS preference option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

run() {
  if [[ "$dry_run" == "1" ]]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

ensure_login_item() {
  local app_name="$1"
  local app_path="/Applications/$app_name.app"
  local script

  if [[ "$dry_run" == "0" && ! -d "$app_path" ]]; then
    printf 'Skipping login item for %s: %s is not installed.\n' "$app_name" "$app_path" >&2
    return
  fi

  printf -v script 'tell application "System Events"\n  if exists login item "%s" then\n    set hidden of login item "%s" to false\n  else\n    make login item at end with properties {path:"%s", hidden:false}\n  end if\nend tell' "$app_name" "$app_name" "$app_path"
  run osascript -e "$script"
}

# Keyboard, saving, spelling, and screenshots.
run defaults write NSGlobalDomain InitialKeyRepeat -int 20
run defaults write NSGlobalDomain KeyRepeat -int 1
run defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
run defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
run defaults write com.apple.screencapture location -string "$HOME/Downloads"
run defaults write com.apple.screencapture type -string png

# Finder and filesystem behavior.
run defaults write NSGlobalDomain AppleShowAllExtensions -bool true
run defaults write com.apple.finder ShowStatusBar -bool true
run defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true

# Dock and appearance.
run defaults write com.apple.dock tilesize -int 30
run defaults write com.apple.dock expose-animation-duration -float 0.15
run defaults write com.apple.dock orientation -string right
run defaults write com.apple.dock autohide -bool true
run defaults write com.apple.dock autohide-delay -float 0.0
run osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to true'

# Keep the clipboard and scratchpad utilities available in every user session.
ensure_login_item "Maccy"

# These settings are deliberately opt-in because they are unusually aggressive.
if [[ "$opinionated" == "1" ]]; then
  run defaults write -g com.apple.mouse.scaling 9.0
  run defaults write -g com.apple.trackpad.scaling 9.0
  run defaults write com.apple.dock persistent-apps -array
fi

if [[ "$dry_run" == "0" ]]; then
  killall Dock >/dev/null 2>&1 || true
  killall Finder >/dev/null 2>&1 || true
fi

printf 'Keyboard repeat changes take full effect after logging out and back in.\n'
