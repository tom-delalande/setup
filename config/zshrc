# Ghostty's Finder service may start Zsh with a trailing slash in $PWD. That
# makes prompts using %c render an empty directory until the first `cd`.
if [[ "$PWD" != "/" && "$PWD" == */ ]]; then
  builtin cd .
fi

# OPENSPEC:START
# OpenSpec shell completions configuration
if [[ -d "$HOME/.zsh/completions" ]]; then
  fpath=("$HOME/.zsh/completions" $fpath)
fi
# OPENSPEC:END

export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git fzf)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
elif [[ -d "$HOME/.zsh/completions" ]]; then
  autoload -Uz compinit
  compinit
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init --cmd cd zsh)"
fi

if command -v trash >/dev/null 2>&1; then
  alias rm='trash'
fi

# Open Lazygit in the current terminal. Using the XDG config directory keeps
# its configuration and recent-repository state in the managed setup files.
_open_lazygit() {
  if (( $+commands[lazygit] )); then
    zle -I
    XDG_CONFIG_HOME="$HOME/.config" lazygit
    zle reset-prompt
  else
    zle -M 'lazygit is not installed'
  fi
}
zle -N _open_lazygit
bindkey '^G' _open_lazygit
