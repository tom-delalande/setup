[user]
	name = Tom Delalande
	email = 80664757+thomas-delalande@users.noreply.github.com
[alias]
	fix = git commit --amend --no-edit
	st = git status
    ro = !git fetch origin && git rebase origin

[core]
    editor = nvim
	autocrlf = input
	excludesfile = /Users/thomas-delalande/.gitignore_global

[push]
    autoSetupRemote = true

[pull]
    rebase = true

[rebase]
    autoStash = true

[push]
    default = current
[init]
	defaultBranch = main
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/thomas-delalande/.stCommitMsg
