[user]
	name = Tom Delalande
	email = 80664757+tom-delalande@users.noreply.github.com

[core]
    editor = nvim
	autocrlf = input
	excludesfile = /Users/thomas-delalande/.gitignore_global

[push]
    autoSetupRemote = true
    default = current

[pull]
    rebase = true

[rebase]
    autoStash = true

[init]
	defaultBranch = main

[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 

[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/thomas-delalande/.stCommitMsg
