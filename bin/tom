#!/usr/bin/env bash

set -euo pipefail

tom_script="${BASH_SOURCE[0]}"
while [[ -L "$tom_script" ]]; do
  link_target="$(readlink "$tom_script")"
  if [[ "$link_target" == /* ]]; then
    tom_script="$link_target"
  else
    tom_script="$(dirname "$tom_script")/$link_target"
  fi
done
TOM_ROOT="$(cd "$(dirname "$tom_script")" && pwd)"
readonly TOM_ROOT

usage() {
  printf 'Usage: tom <command> [args...]\n\n'
  printf 'Commands:\n'
  local script name
  for script in "$TOM_ROOT"/*; do
    name="$(basename "$script")"
    [[ "$name" == "tom" ]] && continue
    printf '  %s\n' "$name"
  done
}

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

command_name="$1"
shift

command_path="$TOM_ROOT/$command_name"
if [[ -x "$command_path" ]]; then
  exec "$command_path" "$@"
fi

printf 'error: unknown command: %s\n' "$command_name" >&2
usage >&2
exit 2
