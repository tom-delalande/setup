#!/usr/bin/env bash

set -euo pipefail

TOM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly TOM_ROOT

usage() {
  printf 'Usage: tom <command> [args...]\n\n'
  printf 'Commands:\n'
  local script name
  for script in "$TOM_ROOT"/*; do
    name="$(basename "$script")"
    [[ "$name" == "tom" ]] && continue
    printf '  %s\n' "$name"
  done
}

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

command_name="$1"
shift

command_path="$TOM_ROOT/$command_name"
if [[ -x "$command_path" ]]; then
  exec "$command_path" "$@"
fi

printf 'error: unknown command: %s\n' "$command_name" >&2
usage >&2
exit 2
